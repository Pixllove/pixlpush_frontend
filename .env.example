# ---------------------------------------------------------------- backend
# Server-side only: the browser never calls the Fastify API directly, so this
# is deliberately NOT prefixed with NEXT_PUBLIC_. The frontend runs on 3000;
# the local Fastify backend runs on 4000.
BACKEND_API_URL=http://localhost:4000/api/v1

# ------------------------------------------------- google sign-in (public)
# Firebase web config. These values ship in the client bundle by design; the
# security of Google sign-in comes from Google's signature on the ID token,
# which the backend verifies. Never put a service-account key here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Same value as API_GATEWAY_SECRET on the backend (32+ random chars). Server-only.
BACKEND_GATEWAY_SECRET=
